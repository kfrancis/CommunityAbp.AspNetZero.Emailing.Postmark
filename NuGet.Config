<?xml version="1.0" encoding="utf-8"?>
<!--
  ABP 11.x packages (net10.0) are published only on the AspNetZero licensed feed, whose URL embeds
  a per-customer key. The URL is therefore never committed: NuGet expands it from the
  ASPNETZERO_NUGET_URL environment variable (set it locally; CI injects it from a repository secret).
  Older ABP lines (9.x / 10.x) still resolve from nuget.org, so Abp* is mapped to both sources.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="aspnetzero" value="%ASPNETZERO_NUGET_URL%" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
      <package pattern="Abp" />
      <package pattern="Abp.*" />
    </packageSource>
    <packageSource key="aspnetzero">
      <package pattern="Abp" />
      <package pattern="Abp.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
